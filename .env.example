# V2 / Render configuration — never commit real values.
NODE_ENV=production
V2_ENABLE_API=true

# The V2 connection is intentionally isolated from the V1 variables. The
# database name in the URL is replaced by V2_APP_DATABASE for both Drizzle and
# the application connection.
V2_DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/placeholder
V2_APP_DATABASE=playcell_leads_v2

# Run `pnpm bootstrap:v2` explicitly after migrations. This account is never
# created from a migration or automatically during service startup.
V2_SUPER_ADMIN_EMAIL=admin@example.com
V2_SUPER_ADMIN_PASSWORD=use-a-strong-unique-password-with-at-least-12-characters
V2_SUPER_ADMIN_NAME=Super Admin
V2_SESSION_SECRET=generate-a-separate-random-secret-with-at-least-32-characters

# Seed de DEMO/HOMOLOGAÇÃO: nunca é executado pelo startup. Defina estes
# valores somente durante uma execução manual de `pnpm seed:v2:demo`.
# V2_DEMO_SEED_CONFIRM=PLAYCELL_V2_DEMO
# V2_DEMO_PASSWORD=use-a-distinct-demo-password

# Required by the signed V2 session cookie.
JWT_SECRET=generate-a-long-random-secret

# Private V2 evidence storage. Render does not provide Forge storage, so use
# an S3-compatible private bucket (AWS S3, Cloudflare R2, etc.). Keep all real
# values in Render secrets. Downloads are server-authorized and time-limited.
V2_EVIDENCE_STORAGE_PROVIDER=s3
V2_EVIDENCE_S3_BUCKET=playcell-v2-evidences
V2_EVIDENCE_S3_REGION=auto
V2_EVIDENCE_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
V2_EVIDENCE_S3_ACCESS_KEY_ID=replace-with-access-key-id
V2_EVIDENCE_S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
# Set true only for providers that require path-style S3 URLs.
V2_EVIDENCE_S3_FORCE_PATH_STYLE=false
