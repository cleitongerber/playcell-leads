# Render / production configuration — never commit real values.
NODE_ENV=production
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=generate-a-long-random-secret

# First administrator created at service startup if it does not exist.
ADMIN_EMAIL=admin@playcell.com.br
ADMIN_PASSWORD=use-a-strong-unique-password-with-at-least-12-characters
ADMIN_NAME=Administrador Playcell
